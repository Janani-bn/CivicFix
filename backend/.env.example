PORT=3000

# AI endpoint input limits
AI_MAX_BODY_SIZE=100kb
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_DESCRIPTION_LENGTH=5000
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_HISTORY_MESSAGE_LENGTH=4000
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_random_secret_here

# Optional: Google Gemini API (for AI Assistant and issue analysis)
# Works with both legacy AIza... and new AQ... keys from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
